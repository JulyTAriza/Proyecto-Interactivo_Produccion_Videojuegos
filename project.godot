; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Detector de Fatiga Cognitiva"
config/version="1.4.0"
config/description="Aplicación de autoevaluación psicológica breve para medir el nivel de fatiga cognitiva. Proyecto Universidad Antonio Nariño."
run/main_scene="res://src/core/main_app.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://src/assets/ui/iconmain.png"

[autoload]

EventBus="*res://src/core/event_bus.gd"
GlobalManager="*res://src/core/global_manager.gd"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

