[gd_scene format=3]

[ext_resource type="Script" path="res://src/components/kit/kit_composition.gd" id="1"]

[node name="KitComposition" type="PanelContainer"]
size_flags_horizontal = 3
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 12

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="LblTitulo" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_type_variation = &"SeccionLabel"
text = "Tu Kit Anti-Fatiga"

[node name="Bandeja" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="LblActiva" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_type_variation = &"SecundarioLabel"
text = "Sección activa"
autowrap_mode = 3
