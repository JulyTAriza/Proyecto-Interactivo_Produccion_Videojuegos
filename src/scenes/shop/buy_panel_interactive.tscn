[gd_scene format=3]

[ext_resource type="Script" path="res://src/scenes/shop/buy_panel_interactive.gd" id="1"]
[ext_resource type="PackedScene" path="res://src/components/navigation/button_nav.tscn" id="2"]
[ext_resource type="PackedScene" path="res://src/components/kit/kit_composition.tscn" id="3"]
[ext_resource type="Theme" path="res://src/assets/ui/ui_theme.tres" id="theme"]
[ext_resource type="Texture2D" path="res://src/assets/icons/icon_cart.svg" id="ico_cart"]
[ext_resource type="Texture2D" path="res://src/assets/icons/icon_trash.svg" id="ico_trash"]
[ext_resource type="Texture2D" path="res://src/assets/icons/icon_back.svg" id="ico_back"]

[node name="BuyPanelInteractive" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("theme")
script = ExtResource("1")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 28
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 28
theme_override_constants/margin_bottom = 20

[node name="VBox" type="VBoxContainer" parent="Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="LblTitulo" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_type_variation = &"TituloLabel"
text = "Arma tu Kit Anti-Fatiga"

[node name="LblInstruccion" type="Label" parent="Margin/VBox"]
layout_mode = 2
theme_type_variation = &"SecundarioLabel"
text = "Elige una bebida, un snack y una actividad. El catálogo se genera desde los recursos del proyecto."
autowrap_mode = 3

[node name="HBox" type="HBoxContainer" parent="Margin/VBox"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 20

[node name="ScrollCatalogo" type="ScrollContainer" parent="Margin/VBox/HBox"]
layout_mode = 2
size_flags_horizontal = 3
horizontal_scroll_mode = 0

[node name="Catalogo" type="VBoxContainer" parent="Margin/VBox/HBox/ScrollCatalogo"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="VBoxDerecha" type="VBoxContainer" parent="Margin/VBox/HBox"]
custom_minimum_size = Vector2(520, 0)
layout_mode = 2
theme_override_constants/separation = 8

[node name="KitComposition" parent="Margin/VBox/HBox/VBoxDerecha" instance=ExtResource("3")]
layout_mode = 2

[node name="LblSubtotal" type="Label" parent="Margin/VBox/HBox/VBoxDerecha"]
layout_mode = 2
theme_override_colors/font_color = Color(0.361, 0.867, 1, 1)
theme_override_font_sizes/font_size = 26
text = "Subtotal: $0"

[node name="LblAlivio" type="Label" parent="Margin/VBox/HBox/VBoxDerecha"]
layout_mode = 2
text = "Alivio estimado del kit: -0 puntos de fatiga"

[node name="LblCupon" type="Label" parent="Margin/VBox/HBox/VBoxDerecha"]
layout_mode = 2
theme_type_variation = &"SecundarioLabel"
text = "Cupones"
autowrap_mode = 3

[node name="HBoxBotones" type="HBoxContainer" parent="Margin/VBox/HBox/VBoxDerecha"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="BtnFactura" parent="Margin/VBox/HBox/VBoxDerecha/HBoxBotones" instance=ExtResource("2")]
layout_mode = 2
disabled = true
text = "Ir a la factura"
icon = ExtResource("ico_cart")
target_scene = "res://src/scenes/shop/purchase_invoice_interactive.tscn"

[node name="BtnVaciar" type="Button" parent="Margin/VBox/HBox/VBoxDerecha/HBoxBotones"]
layout_mode = 2
disabled = true
text = "Vaciar kit"
icon = ExtResource("ico_trash")

[node name="BtnVolver" parent="Margin/VBox/HBox/VBoxDerecha/HBoxBotones" instance=ExtResource("2")]
layout_mode = 2
text = "Menú"
icon = ExtResource("ico_back")
target_scene = "res://src/scenes/menu/menu_panel.tscn"
discard_previous = true
