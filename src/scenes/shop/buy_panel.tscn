[gd_scene format=3]

[ext_resource type="Script" path="res://src/scenes/shop/buy_panel.gd" id="1"]
[ext_resource type="PackedScene" path="res://src/components/navigation/button_nav.tscn" id="2"]
[ext_resource type="Theme" path="res://src/assets/ui/ui_theme.tres" id="theme"]
[ext_resource type="Texture2D" path="res://src/assets/icons/icon_cart.svg" id="ico_cart"]
[ext_resource type="Texture2D" path="res://src/assets/icons/icon_coupon.svg" id="ico_coupon"]
[ext_resource type="Texture2D" path="res://src/assets/icons/icon_back.svg" id="ico_back"]
[ext_resource type="Texture2D" path="res://src/assets/icons/icon_trash.svg" id="ico_trash"]

[sub_resource type="ButtonGroup" id="GrupoPlanes"]

[node name="BuyPanel" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")
theme = ExtResource("theme")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 24

[node name="Scroll" type="ScrollContainer" parent="Margin"]
layout_mode = 2
horizontal_scroll_mode = 0

[node name="VBox" type="VBoxContainer" parent="Margin/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 14

[node name="LblTitulo" type="Label" parent="Margin/Scroll/VBox"]
layout_mode = 2
text = "Tienda de Bienestar"
theme_type_variation = &"TituloLabel"

[node name="LblInstruccion" type="Label" parent="Margin/Scroll/VBox"]
layout_mode = 2
text = "Elige un plan de descanso. Si tienes cupones ganados en Enfoque Rush, el mejor que aplique se descontará en la factura."
autowrap_mode = 3
theme_type_variation = &"SecundarioLabel"

[node name="Planes" type="VBoxContainer" parent="Margin/Scroll/VBox"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="BtnPausaActiva" type="Button" parent="Margin/Scroll/VBox/Planes"]
custom_minimum_size = Vector2(0, 64)
layout_mode = 2
toggle_mode = true
button_group = SubResource("GrupoPlanes")
text = "Plan Pausa Activa"
alignment = 0

[node name="BtnDescansoProfundo" type="Button" parent="Margin/Scroll/VBox/Planes"]
custom_minimum_size = Vector2(0, 64)
layout_mode = 2
toggle_mode = true
button_group = SubResource("GrupoPlanes")
text = "Plan Descanso Profundo"
alignment = 0

[node name="BtnBienestarTotal" type="Button" parent="Margin/Scroll/VBox/Planes"]
custom_minimum_size = Vector2(0, 64)
layout_mode = 2
toggle_mode = true
button_group = SubResource("GrupoPlanes")
text = "Plan Bienestar Total"
alignment = 0

[node name="LblSeleccion" type="Label" parent="Margin/Scroll/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.36, 0.87, 1, 1)
theme_override_font_sizes/font_size = 20
text = "Aún no has elegido un plan."
autowrap_mode = 3

[node name="LblCupones" type="Label" parent="Margin/Scroll/VBox"]
layout_mode = 2
text = "Cupones"
autowrap_mode = 3

[node name="HSeparator" type="HSeparator" parent="Margin/Scroll/VBox"]
layout_mode = 2

[node name="HBoxBotones" type="HBoxContainer" parent="Margin/Scroll/VBox"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="BtnFactura" parent="Margin/Scroll/VBox/HBoxBotones" instance=ExtResource("2")]
layout_mode = 2
disabled = true
text = "Ir a la factura"
target_scene = "res://src/scenes/shop/purchase_invoice.tscn"
icon = ExtResource("ico_cart")

[node name="BtnVaciar" type="Button" parent="Margin/Scroll/VBox/HBoxBotones"]
layout_mode = 2
disabled = true
text = "Quitar plan"
icon = ExtResource("ico_trash")

[node name="BtnCupones" parent="Margin/Scroll/VBox/HBoxBotones" instance=ExtResource("2")]
layout_mode = 2
text = "Mis cupones"
target_scene = "res://src/scenes/coupon/coupon_event.tscn"
icon = ExtResource("ico_coupon")

[node name="BtnVolver" parent="Margin/Scroll/VBox/HBoxBotones" instance=ExtResource("2")]
layout_mode = 2
text = "Volver al menú"
target_scene = "res://src/scenes/menu/menu_panel.tscn"
discard_previous = true

icon = ExtResource("ico_back")