[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://src/scenes/history/history_panel.gd" id="1"]
[ext_resource type="PackedScene" path="res://src/components/navigation/button_nav.tscn" id="2"]
[ext_resource type="Theme" path="res://src/assets/ui/ui_theme.tres" id="theme"]
[ext_resource type="Texture2D" path="res://src/assets/icons/icon_back.svg" id="ico_back"]

[node name="HistoryPanel" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")
theme = ExtResource("theme")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 32
theme_override_constants/margin_top = 24
theme_override_constants/margin_right = 32
theme_override_constants/margin_bottom = 24

[node name="Scroll" type="ScrollContainer" parent="Margin"]
layout_mode = 2
horizontal_scroll_mode = 0

[node name="VBoxContainer" type="VBoxContainer" parent="Margin/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="LblTitulo" type="Label" parent="Margin/Scroll/VBoxContainer"]
layout_mode = 2
text = "Historial de Evaluaciones"
theme_type_variation = &"TituloLabel"

[node name="LblSubtitulo" type="Label" parent="Margin/Scroll/VBoxContainer"]
layout_mode = 2
autowrap_mode = 3
text = "Estos resultados se cargan desde disco (user://fatiga_historial.json) y persisten aunque cierres la aplicación."
