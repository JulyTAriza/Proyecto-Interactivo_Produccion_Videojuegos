[node name="HSeparator1" type="HSeparator" parent="Margin/Scroll/VBoxContainer"]
layout_mode = 2

[node name="LblVacio" type="Label" parent="Margin/Scroll/VBoxContainer"]
layout_mode = 2
autowrap_mode = 3
text = "Aún no has guardado ninguna evaluación. Ve a \"Iniciar Evaluación\" y presiona \"Finalizar y Guardar Evaluación\" para ver tu primer registro aquí."
theme_type_variation = &"SecundarioLabel"

[node name="ListaRegistros" type="VBoxContainer" parent="Margin/Scroll/VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 6

[node name="HSeparator2" type="HSeparator" parent="Margin/Scroll/VBoxContainer"]
layout_mode = 2

[node name="BtnVolver" parent="Margin/Scroll/VBoxContainer" instance=ExtResource("2")]
layout_mode = 2
size_flags_horizontal = 0
text = "Volver al Menú"
target_scene = "res://src/scenes/menu/menu_panel.tscn"
